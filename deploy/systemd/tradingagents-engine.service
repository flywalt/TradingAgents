[Unit]
Description=TradingAgents engine (queue, worker, artifacts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradingagents
WorkingDirectory=/opt/TradingAgents
EnvironmentFile=/opt/TradingAgents/.env
# loopback only: the UI is the sole entry point
ExecStart=/opt/TradingAgents/.venv/bin/python -m tradingagents_web --role engine --port 8502
Restart=always
RestartSec=3
# the engine holds the only writer on state.db
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
