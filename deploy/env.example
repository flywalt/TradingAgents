# copy to .env (chmod 600). Every value is a secret except the language.
TRADINGAGENTS_WEB_TOKEN=          # browser login; 32+ random chars
TRADINGAGENTS_ENGINE_TOKEN=       # UI -> engine; a different random string
TRADINGAGENTS_OUTPUT_LANGUAGE=中文
TZ=Asia/Shanghai

# data vendors
TUSHARE_TOKEN=
RSSHUB_BASE_URL=http://127.0.0.1:1200
RSSHUB_TOKEN=                     # must equal ACCESS_KEY in the RSSHub compose

# model provider (the engine calls it; the VPS needs outbound HTTPS)
OPENAI_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=
