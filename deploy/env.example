# 复制为 .env 后逐项填写，并 chmod 600 .env。
# 注释一律单独成行：systemd 的 EnvironmentFile 不认行尾注释，
# 会把 "# ..." 当成值的一部分。
# 两个令牌必须不同，各 32 位以上随机串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# 浏览器登录口令
TRADINGAGENTS_WEB_TOKEN=

# UI -> 引擎 的服务令牌（只在服务端之间使用）
TRADINGAGENTS_ENGINE_TOKEN=

# 可选：给只读访问发的独立令牌（不填则只认上面那颗）
TRADINGAGENTS_WEB_READ_TOKEN=

# 分析输出语言
TRADINGAGENTS_OUTPUT_LANGUAGE=中文

# 时区：不设会让"今天"与交易日期差 8 小时
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 数据源
TUSHARE_TOKEN=

# RSSHub 实例；与 deploy/rsshub/docker-compose.yml 的 ACCESS_KEY 必须一致
RSSHUB_BASE_URL=http://127.0.0.1:1200
RSSHUB_TOKEN=

# 可选：K 线图外链前缀（不填则报告里不出现该链接）
KVIEWER_BASE_URL=

# ---------------------------------------------------------------- 模型
# 引擎需要出站 HTTPS 才能调模型服务
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------------------------------------------------------------- 代理
# 仅当反代不在本机（隧道）时改动，默认只信任回环来的 X-Forwarded-*
# FORWARDED_ALLOW_IPS=127.0.0.1
