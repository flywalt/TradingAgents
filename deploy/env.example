# 复制为 /srv/tradingagents/.env 并 chmod 600（vps-deploy 只校验存在性与权限）。
# 注释一律单独成行：systemd 的 EnvironmentFile 不认行尾注释。

# ── 部署形态（必填）────────────────────────────────────────────
# 运行时状态根目录（D-0058 单一开关：web db / memory / logs / cache 全部落在这里）
TRADINGAGENTS_HOME=/srv/tradingagents/data

# 时区：不设会让"今天"与交易日期差 8 小时
TZ=Asia/Shanghai

# ── 凭据（app.toml env_required 三项，缺了 preflight 不过）────
# 浏览器登录口令：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRADINGAGENTS_WEB_TOKEN=

# LLM 后端密钥（TRADINGAGENTS_LLM_PROVIDER 选哪个就填哪个的）
OPENAI_COMPATIBLE_API_KEY=
TUSHARE_TOKEN=

# 统一鉴权门（Caddy forward_auth）已经验过身份时，不再要求应用口令。
# 只在 ui 角色生效；引擎仍只认服务令牌。留空 = 不信任任何注入的身份头。
TRADINGAGENTS_TRUST_FORWARD_AUTH=1

# ── 凭据（可选，但生产已用）──────────────────────────────────
# UI -> 引擎 的服务令牌：生成 secrets.token_urlsafe(32) 填这里，ui 用它对 engine 发请求；
# 设了之后 engine 只认这颗，浏览器口令（TRADINGAGENTS_WEB_TOKEN）直打 engine 会 401。
# 不填则回落用 TRADINGAGENTS_WEB_TOKEN 转发（单机可跑，但服务边界消失）。
# TRADINGAGENTS_ENGINE_TOKEN=

# 只读访问独立令牌：不填则只认 TRADINGAGENTS_WEB_TOKEN。
# ⚠ 启用前先修代理的方法分流（当前 /api/* 对所有方法都用 require_read，只读令牌能提交任务）。
# TRADINGAGENTS_WEB_READ_TOKEN=

# ── LLM 配置（按 dev .env 迁移）──────────────────────────────
TRADINGAGENTS_LLM_PROVIDER=
TRADINGAGENTS_LLM_BACKEND_URL=
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
MINIMAX_CN_API_KEY=

# 分析输出语言（缺省 English）
TRADINGAGENTS_OUTPUT_LANGUAGE=中文

# ── 旁路：外部 RSSHub（不在本机；key 被拒时新闻源降级，不阻断）──
# 值必须与该实例的 ACCESS_KEY 一致，否则所有路由 403。轮换后同步这里并重启两个 unit。
# RSSHUB_BASE_URL=https://rsshub.dafeis.com
# RSSHUB_TOKEN=

# ── 可选──────────────────────────────────────────────────────
# K 线图外链前缀（不填则报告里不出现该链接）
# KVIEWER_BASE_URL=https://kviewer.dafeis.com
