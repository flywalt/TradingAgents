# Public shell: automatic HTTPS, UI on loopback, engine stays private.
#   caddy run --config deploy/caddy/Caddyfile.vps --envfile /etc/caddy/stock.env
#
# stock.env (chmod 600):
#   STOCK_DOMAIN=stock.example.com
#   CADDY_EMAIL=you@example.com
{
	email {$CADDY_EMAIL}
	admin off
}

{$STOCK_DOMAIN} {
	tls {$CADDY_EMAIL}

	encode zstd gzip

	# HSTS only after you are sure the certificate renews unattended
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Only the UI is exposed. The engine listens on 127.0.0.1:8502 and is
	# never routed here; the UI injects the service token on its own hop.
	reverse_proxy 127.0.0.1:8501 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
	}

	log {
		output file {$CADDY_LOG_DIR:/var/log/caddy}/stock-vps.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# If instead the UI stays at home and only Caddy runs on the VPS, replace the
# reverse_proxy above with the tunnel endpoint, e.g.
#   reverse_proxy 100.x.y.z:8501 { flush_interval -1 }
# or point it at the local end of a Cloudflare tunnel. Keep the engine out of
# that path either way.
